# ===========================================================================
# Predictive Maintenance Platform — Environment Variables
# ===========================================================================
# Copy this file to .env and fill in values for your deployment environment.
# NEVER commit .env to version control.
#
# All variables use the PMP_ prefix to avoid collisions with system env vars.
# ===========================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Connection string format:
#   postgresql+asyncpg://user:password@host:port/database
PMP_DATABASE_URL=postgresql+asyncpg://pmp:changeme@localhost:5432/predictive_maintenance
PMP_DATABASE_URL_SYNC=postgresql+psycopg2://pmp:changeme@localhost:5432/predictive_maintenance
PMP_DB_POOL_SIZE=10
PMP_DB_MAX_OVERFLOW=20
PMP_DB_POOL_TIMEOUT=30

# ---------------------------------------------------------------------------
# Redis (Cache / Message Broker)
# ---------------------------------------------------------------------------
PMP_REDIS_URL=redis://localhost:6379/0
PMP_REDIS_MAX_CONNECTIONS=50
PMP_REDIS_SOCKET_TIMEOUT=5

# ---------------------------------------------------------------------------
# MLflow (Experiment Tracking & Model Registry)
# ---------------------------------------------------------------------------
PMP_MLFLOW_TRACKING_URI=http://localhost:5000
PMP_MLFLOW_EXPERIMENT_NAME=predictive-maintenance
PMP_MODEL_STAGE=Production
PMP_MODEL_REGISTRY_NAME=failure_predictor

# ---------------------------------------------------------------------------
# API Server (FastAPI / Uvicorn)
# ---------------------------------------------------------------------------
PMP_API_HOST=0.0.0.0
PMP_API_PORT=8000
PMP_API_WORKERS=4
PMP_API_RELOAD=false
PMP_API_TIMEOUT_KEEP_ALIVE=30
PMP_API_MAX_CONCURRENT_CONNECTIONS=1000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
PMP_LOG_LEVEL=INFO
# Log format: json (production) | console (development)
PMP_LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Monitoring & Drift Detection
# ---------------------------------------------------------------------------
PMP_DRIFT_CHECK_INTERVAL_HOURS=24
PMP_DRIFT_MIN_REFERENCE_SAMPLES=1000
PMP_DRIFT_MIN_CURRENT_SAMPLES=500
PMP_DRIFT_PVALUE_THRESHOLD=0.05

# ---------------------------------------------------------------------------
# Data Quality Gates
# ---------------------------------------------------------------------------
PMP_DATA_QUALITY_MIN_COMPLETENESS=0.98
PMP_DATA_QUALITY_MAX_DUPLICATE_RATE=0.001
PMP_DATA_QUALITY_MAX_OUTLIER_ZSCORE=4.0

# ---------------------------------------------------------------------------
# Alerting
# ---------------------------------------------------------------------------
PMP_ALERT_WEBHOOK_URL=
PMP_ALERT_EMAIL_SMTP_HOST=
PMP_ALERT_EMAIL_FROM=alerts@predictive-maintenance.local
PMP_ALERT_COOLDOWN_MINUTES=15

# ---------------------------------------------------------------------------
# Security (JWT)
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PMP_JWT_SECRET_KEY=change-me-in-production-use-opaque-secret
PMP_JWT_ALGORITHM=HS256
PMP_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# Feature Engineering
# ---------------------------------------------------------------------------
PMP_FEATURE_WINDOW_MINUTES=60
# Comma-separated list of rolling window sizes
PMP_FEATURE_ROLLING_WINDOW_SIZES="[5,15,30,60]"
PMP_FEATURE_LAG_PERIODS="[1,3,6,12]"

# ---------------------------------------------------------------------------
# Inference
# ---------------------------------------------------------------------------
PMP_INFERENCE_BATCH_SIZE=256
PMP_INFERENCE_CACHE_TTL_SECONDS=300
PMP_PREDICTION_THRESHOLD=0.5

# ---------------------------------------------------------------------------
# Synthetic Data Generation (DEV ONLY — do not set in production)
# ---------------------------------------------------------------------------
PMP_SYNTHETIC_EQUIPMENT_COUNT=50
PMP_SYNTHETIC_DAYS_OF_HISTORY=90
PMP_SYNTHETIC_FAILURE_RATE=0.02
PMP_SYNTHETIC_SEED=42
